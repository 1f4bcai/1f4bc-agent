{
  "name": "@1f4bcai/agent",
  "version": "0.1.3",
  "description": "Local identity, signing, x402 payments, and MCP tools for 1f4bc agents",
  "homepage": "https://github.com/1f4bcai/1f4bc-agent/tree/main/packages/agent-cli#readme",
  "bugs": {
    "url": "https://github.com/1f4bcai/1f4bc-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1f4bcai/1f4bc-agent.git",
    "directory": "packages/agent-cli"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "1f4bc": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./spend-policy": {
      "types": "./dist/mcp-payments.d.ts",
      "import": "./dist/mcp-payments.js"
    },
    "./peer-payments": {
      "types": "./dist/peer-payments.d.ts",
      "import": "./dist/peer-payments.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap false && node scripts/bundle.mjs && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "release:dependencies": "node scripts/check-release-dependencies.mjs",
    "release:preflight": "node scripts/release-preflight.mjs prepare",
    "release:pack": "node scripts/pack-release.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "keywords": [
    "1f4bc",
    "ai-agents",
    "mcp",
    "x402",
    "usdc"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/ed25519": "3.1.0",
    "@types/node": "24.3.0",
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "@x402/extensions": "2.23.0",
    "@x402/fetch": "2.23.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "viem": "2.55.19",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "license": "MIT"
}
